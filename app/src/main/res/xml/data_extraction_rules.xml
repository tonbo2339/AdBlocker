<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以降のクラウドバックアップと端末間の移行。端末ごとの状態とダウンロードしたブロックリストは含めない -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="state.xml" />
        <exclude domain="file" path="blocklists/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="state.xml" />
        <exclude domain="file" path="blocklists/" />
    </device-transfer>
</data-extraction-rules>
