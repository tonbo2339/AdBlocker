<?xml version="1.0" encoding="utf-8"?>
<!-- 設定 (ホームの右上の ≡ から開く)。行頭アイコンは装飾なので読み上げない -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="ContentDescription,TooManyViews">

    <LinearLayout
        android:id="@+id/backButton"
        style="@style/BackButton"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/app_name"
            android:textColor="@color/accent_blue"
            android:textSize="17sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="40dp">

            <TextView
                style="@style/LargeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/title_settings" />

            <!-- ブロックの設定 -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/section_filtering" />

            <io.github.tonbo2339.adblocker.CardLayout style="@style/Card">

                <LinearLayout
                    android:id="@+id/rulesRow"
                    style="@style/Row.Clickable">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/sys_indigo"
                        android:src="@drawable/ic_g_rules" />

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/title_rules" />

                    <TextView
                        android:id="@+id/rulesValue"
                        style="@style/RowValue" />

                    <ImageView style="@style/Chevron" />
                </LinearLayout>

                <View style="@style/Separator.Inset" />

                <LinearLayout style="@style/Row">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/sys_gray"
                        android:src="@drawable/ic_g_doc" />

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/row_query_log" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/queryLogSwitch"
                        style="@style/IosSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </io.github.tonbo2339.adblocker.CardLayout>

            <TextView
                style="@style/SectionFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/query_log_footer" />

            <!-- ブロックリスト -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_blocklist" />

            <io.github.tonbo2339.adblocker.CardLayout style="@style/Card">

                <LinearLayout
                    android:id="@+id/listsRow"
                    style="@style/Row.Clickable">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/sys_orange"
                        android:src="@drawable/ic_g_doc" />

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/title_blocklists" />

                    <TextView
                        android:id="@+id/listsValue"
                        style="@style/RowValue" />

                    <ImageView style="@style/Chevron" />
                </LinearLayout>

                <View style="@style/Separator.Inset" />

                <LinearLayout style="@style/Row">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/sys_red"
                        android:src="@drawable/ic_g_list" />

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/row_domains" />

                    <TextView
                        android:id="@+id/blocklistValue"
                        style="@style/RowValue"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>

                <View style="@style/Separator.Inset" />

                <LinearLayout style="@style/Row">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/sys_gray"
                        android:src="@drawable/ic_g_clock" />

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/row_last_checked" />

                    <TextView
                        android:id="@+id/lastCheckedValue"
                        style="@style/RowValue" />
                </LinearLayout>

                <View style="@style/Separator.Inset" />

                <LinearLayout
                    android:id="@+id/updateRow"
                    style="@style/Row.Clickable">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/accent_blue"
                        android:src="@drawable/ic_g_refresh" />

                    <TextView
                        android:id="@+id/updateText"
                        style="@style/RowTitle"
                        android:text="@string/row_update_now"
                        android:textColor="@color/accent_blue" />

                    <ProgressBar
                        android:id="@+id/updateProgress"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:visibility="gone" />
                </LinearLayout>
            </io.github.tonbo2339.adblocker.CardLayout>

            <TextView
                android:id="@+id/sourcesFooter"
                style="@style/SectionFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 自動更新 -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_auto_update" />

            <io.github.tonbo2339.adblocker.CardLayout style="@style/Card">

                <LinearLayout style="@style/Row">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/accent_blue"
                        android:src="@drawable/ic_g_wifi" />

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/row_wifi_only" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/wifiOnlySwitch"
                        style="@style/IosSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </io.github.tonbo2339.adblocker.CardLayout>

            <TextView
                style="@style/SectionFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wifi_only_footer" />

            <!-- アプリ -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_app" />

            <io.github.tonbo2339.adblocker.CardLayout style="@style/Card">

                <LinearLayout style="@style/Row">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/sys_gray"
                        android:src="@drawable/ic_g_info" />

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/row_version" />

                    <TextView
                        android:id="@+id/versionValue"
                        style="@style/RowValue" />
                </LinearLayout>

                <View style="@style/Separator.Inset" />

                <LinearLayout style="@style/Row">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/accent_blue"
                        android:src="@drawable/ic_g_download" />

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/row_auto_install" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/autoInstallSwitch"
                        style="@style/IosSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Separator.Inset" />

                <LinearLayout
                    android:id="@+id/checkUpdateRow"
                    style="@style/Row.Clickable">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/accent_blue"
                        android:src="@drawable/ic_g_refresh" />

                    <TextView
                        android:id="@+id/checkUpdateText"
                        style="@style/RowTitle"
                        android:text="@string/row_check_update"
                        android:textColor="@color/accent_blue" />

                    <ProgressBar
                        android:id="@+id/checkUpdateProgress"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:visibility="gone" />
                </LinearLayout>
            </io.github.tonbo2339.adblocker.CardLayout>

            <TextView
                style="@style/SectionFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_update_footer" />

            <!-- 通知 -->
            <TextView
                style="@style/SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_notifications" />

            <io.github.tonbo2339.adblocker.CardLayout style="@style/Card">

                <LinearLayout style="@style/Row">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/sys_red"
                        android:src="@drawable/ic_g_bell" />

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/notify_app_update" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notifyAppUpdateSwitch"
                        style="@style/IosSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Separator.Inset" />

                <LinearLayout style="@style/Row">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/sys_orange"
                        android:src="@drawable/ic_g_list" />

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/notify_blocklist_update" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notifyBlocklistSwitch"
                        style="@style/IosSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Separator.Inset" />

                <LinearLayout style="@style/Row">

                    <ImageView
                        style="@style/IconBadge"
                        android:backgroundTint="@color/sys_green"
                        android:src="@drawable/ic_g_shield" />

                    <TextView
                        style="@style/RowTitle"
                        android:text="@string/notify_running" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/notifyRunningSwitch"
                        style="@style/IosSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </io.github.tonbo2339.adblocker.CardLayout>

            <TextView
                style="@style/SectionFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notifications_footer" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
