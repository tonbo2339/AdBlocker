<?xml version="1.0" encoding="utf-8"?>
<!--
  下のタブ (ホーム / 統計 / ログ) で切り替える 3 つのページと、右上の ≡ から開く設定画面。
  ページをスクロールすると大きなタイトルが隠れ、上部のナビゲーションバーに小さなタイトルが出る (iOS 風)。
-->
<!-- タブのアイコンは文字の飾りなので読み上げない (TabIcon スタイル)。色を状態で変えるので compound drawable にしない -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    tools:ignore="ContentDescription,UseCompoundDrawables"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/home"
        layout="@layout/page_home" />

    <include
        android:id="@+id/stats"
        layout="@layout/page_stats"
        android:visibility="gone" />

    <include
        android:id="@+id/log"
        layout="@layout/page_log"
        android:visibility="gone" />

    <!-- ナビゲーションバー (スクロールすると背景と小さなタイトルが出る) -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <TextView
                android:id="@+id/navTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:gravity="center"
                android:textColor="@color/label"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_settings"
                android:src="@drawable/ic_menu" />
        </FrameLayout>

        <View
            android:id="@+id/navDivider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:alpha="0"
            android:background="@color/separator" />
    </LinearLayout>

    <!-- タブバー -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/tab_bar_bg"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/separator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabHome"
                style="@style/TabItem">

                <ImageView
                    style="@style/TabIcon"
                    android:src="@drawable/ic_tab_home" />

                <TextView
                    style="@style/TabLabel"
                    android:text="@string/tab_home" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabStats"
                style="@style/TabItem">

                <ImageView
                    style="@style/TabIcon"
                    android:src="@drawable/ic_tab_stats" />

                <TextView
                    style="@style/TabLabel"
                    android:text="@string/tab_stats" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabLog"
                style="@style/TabItem">

                <ImageView
                    style="@style/TabIcon"
                    android:src="@drawable/ic_tab_log" />

                <TextView
                    style="@style/TabLabel"
                    android:text="@string/tab_log" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
