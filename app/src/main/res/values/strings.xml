    <string name="rule_hint" translatable="false">example.com / ads.* / 203.0.113.7</string>
    <string name="rule_invalid">That isn\'t a valid domain, pattern or IP address</string>
    <string name="rules_footer_block">Blocks the domain and all of its subdomains, even if it isn\'t on a blocklist. You can use * as a wildcard (such as ads.* or *tracker*). An IP address (or a range such as 203.0.113.0/24) blocks any name that resolves to it.</string>
    <string name="rules_footer_allow">Always allows the domain and all of its subdomains. Use this when blocking breaks a site or an app. You can use * as a wildcard. Allow rules win over block rules.</string>
