    <string name="row_encrypted_dns">Encrypted DNS</string>
    <string name="encrypted_dns_off">Off</string>
    <string name="encrypted_dns_footer">Sends lookups over DNS over TLS so your network can\'t read or change them. If the server can\'t be reached, your network\'s DNS is used instead. While it\'s on, names that only your network knows (such as company or router names) may not work.</string>
    <string name="section_backup">Backup</string>
    <string name="row_export">Export Settings</string>
    <string name="row_import">Import Settings</string>
    <string name="backup_footer">Saves your blocked and allowed domains, excluded apps, Wi-Fi networks without blocking, blocklists and other settings to a file, for moving to a new phone. Statistics and the log are not included.</string>
    <string name="export_done">Settings exported</string>
    <string name="export_failed">Couldn\'t save the file</string>
    <string name="query_log_footer_saved">Keeps the last 500 lookups and the most-blocked domains and apps in memory, and also saves the log to a file on this phone for %1$s (it never leaves the phone). Older entries are deleted automatically. Export the log to see all of it.</string>
    <string name="log_footer_saved">The last %1$s lookups. The log is also saved on this phone for %2$s. Tap a row to block or allow it.</string>
