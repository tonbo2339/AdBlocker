<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 転送先 DNS を決めるため、Wi-Fi / モバイル回線の DNS サーバーを調べる -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- GitHub Releases から自分自身を更新する -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
        「広告ブロックをしない Wi-Fi」でつながっている Wi-Fi の名前を読む (Android の仕様で位置情報の許可が要る。位置は使わない)。
        画面を閉じている間も切り替えるので「常に許可」も使う。どれも利用者がその機能を使うときだけ尋ねる
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- 例外アプリを選ぶためにインストール済みアプリの一覧を取得する -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".AdBlockerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdBlocker">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- ランチャーのショートカットから呼ばれる。画面は出さない -->
        <activity
            android:name=".ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".AppListActivity"
            android:exported="false"
            android:label="@string/title_exclusions"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".DnsSettingsActivity"
            android:exported="false"
            android:label="@string/title_dns"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".LogSettingsActivity"
            android:exported="false"
            android:label="@string/title_log"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".UpdateSettingsActivity"
            android:exported="false"
            android:label="@string/title_updates"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".NotificationSettingsActivity"
            android:exported="false"
            android:label="@string/section_notifications"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".BackupSettingsActivity"
            android:exported="false"
            android:label="@string/section_backup"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".WifiSettingsActivity"
            android:exported="false"
            android:label="@string/title_unblocked_wifi"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".DeveloperSettingsActivity"
            android:exported="false"
            android:label="@string/title_developer"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".BlocklistsActivity"
            android:exported="false"
            android:label="@string/title_blocklists"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".RulesActivity"
            android:exported="false"
            android:label="@string/title_rules"
            android:parentActivityName=".SettingsActivity" />

        <service
            android:name=".AdBlockVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local DNS-filtering VPN that blocks ad domains on the device" />
        </service>

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".ResumeReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AdBlockTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>

</manifest>
